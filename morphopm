/** Perform a sytem command, checking that the return code is zero and if not raising an error  */
fn systemErrCheck(String command, Error err) {
  if (system(command)!=0) err.throw() 
}

/** Returns true if a normalized path is absolute on the current platform */
fn _isAbsolutePath(path) {
  if (path.count()==0) return false
  if (path[0]=="/") return true
  if (path.count()>=2 && path[1]==":") return true
  return false
}

/** Resolve a relative path against the current working folder */
fn _absPath(path) {
  path = Folder.normalizePath(path)
  if (_isAbsolutePath(path)) return path
  return Folder.normalizePath("${System.workingfolder()}/${path}")
}

/** Last path component, handling both / and \ separators */
fn _baseName(path) {
  var parts = Folder.normalizePath(path).split("/\\")
  if (parts.count()==0) return path
  return parts[-1]
}

// First non-empty line, without a trailing carriage return
fn _firstLine(text) {
  if (!text) return ""
  for (part in text.split("\r\n")) {
    if (part.count()>0) return part
  }
  return ""
}

// Parent directory of a file or folder
fn _parentDir(path) {
  var parts = []
  for (part in Folder.normalizePath(path).split("/\\")) {
    if (part.count()>0) parts.append(part)
  }
  if (parts.count()<2) return path
  parts.pop()
  return Folder.normalizePath(String.join(parts, "/"))
}

// Path with forward slashes
fn _forward(path) {
  return String.join(Folder.normalizePath(path).split("\\"), "/")
}

/** Displays a table */
fn displayTable(Array a) {
  var b = a.clone() 
  var dim = a.dimensions() 
  var nrows = dim[0], ncols = dim[1]
  var widths[dim[1]]

  for (j in 0...ncols) { // Calculate maximum width of each column
    widths[j]=0

    for (i in 0...nrows) {
      if (!isstring(a[i,j])) b[i,j]=String(a[i,j])

      var w = b[i,j].count()
      if (w>widths[j]) widths[j]=w
    }
  }

  var out = ""
  for (i in 0...nrows) {
    for (j in 0...ncols) {
      var w = b[i,j].count()
      for (k in 0...widths[j]-w) out+=" "
      out+=b[i,j]+" "
    }
    if (i<nrows-1) out+="\n"
  }

  print out
}

/* -------------------
 * Version 
 * ------------------- */

class Version {
  init(str) {
    self.parse(str)
  }

  parse(str) {
    try {
      var el = str.split(".")
      self.major = Int(el[0])
      self.minor = Int(el[1])
      self.patch = Int(el[2])
    } catch {
      "ExpctArgNm" : ErrMorphoVrsnPrse.throw() 
      "IndxBnds" : ErrMorphoVrsnPrse.throw() 
    }
  }

  eq(Version v) {
    return (self.major == v.major &&
            self.minor == v.minor &&
            self.patch == v.patch)
  }
  
  gt(Version v) {
    if (self.major > v.major) return true  
    else if (self.major < v.major) return false 

    if (self.minor > v.minor) return true 
    if (self.minor < v.minor) return false 

    if (self.patch > v.patch) return true 
    return false 
  }

  ge(Version v) {
    return self.eq(v) || self.gt(v)
  }

  toString() {
    return "${self.major}.${self.minor}.${self.patch}"
  }

  prnt() {
    System.prnt(self.toString())
  }
}

/* A requirement is empty (any version), ">=X.Y.Z", or an exact "X.Y.Z". */
class VersionConstraint {
  init(str) {
    self.kind = "any"
    self.version = nil
    if (!isstring(str) || str.count()==0) return
    if (str.count()>=2 && str.substring(0, 2)==">=") {
      self.kind = "ge"
      self.version = Version(str.substring(2, str.count()))
    } else {
      self.kind = "eq"
      self.version = Version(str)
    }
  }

  satisfied(Version v) {
    if (self.kind=="any") return true
    if (self.kind=="ge") return v.ge(self.version)
    return v.eq(self.version)
  }

  toString() {
    if (self.kind=="any") return "any"
    if (self.kind=="ge") return ">=${self.version.toString()}"
    return self.version.toString()
  }
}

/** Version reported by `morpho6 --version`, which prints "Morpho vX.Y.Z". */
var _morphoVersion = nil
fn currentMorphoVersion() {
  if (_morphoVersion) return _morphoVersion
  var result = System.subprocess("morpho6 --version")
  if (result["exitstatus"] != 0) ErrMorphoVrsnPrse.throw()
  var parts = result["stdout"].split("v")
  _morphoVersion = Version(parts[-1])
  return _morphoVersion
}

