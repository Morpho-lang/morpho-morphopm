/** Names and distro ids that map onto a package manager. */
var _pkgMgrNames = {
  "apt" : "apt", "debian" : "apt", "ubuntu" : "apt", "linuxmint" : "apt", "pop" : "apt",
  "pacman" : "pacman", "arch" : "pacman",
  "dnf" : "dnf", "fedora" : "dnf", "rhel" : "dnf", "centos" : "dnf", "rocky" : "dnf", "almalinux" : "dnf",
  "brew" : "brew", "homebrew" : "brew",
  "winget" : "winget"
}

/** Display name and install command for each package manager. */
var _pkgMgrInstall = {
  "brew" : [ "homebrew", "brew install --quiet" ],
  "winget" : [ "winget", "winget install" ],
  "apt" : [ "apt-get", "sudo apt-get install" ],
  "pacman" : [ "pacman", "sudo pacman -S --needed" ],
  "dnf" : [ "dnf", "sudo dnf install" ]
}

/** Shared behavior for installing one dependency or a list of them. */
class ExternalPackageManager {
  installAll(deps) {
    if (!deps) return
    if (isstring(deps)) self.install(deps)
    else for (dep in deps) self.install(dep)
  }
}

/** The system package manager used to install dependencies such as apt or brew. */
class SystemPackageManager is ExternalPackageManager {
  init(label) {
    if (label) {
      if (!_pkgMgrNames.contains(label)) ErrMorphoPMPkgMgr.throw("Unrecognized package manager ${label}. Use apt, pacman, dnf, brew, or winget")
      self.name = _pkgMgrNames[label]
    } else self.name = self._detect()
  }

  install(dep) {
    var spec = _pkgMgrInstall[self.name]
    print "Using ${spec[0]} to install ${dep}"
    if (self.name=="winget") print "Winget may launch a separate window to perform the installation; you may need to accept the installation."
    else if (self.name!="brew") print "Please note ${self.name} may ask you for your password to install missing packages."
    if (self.name=="winget") {
      var status = system("${spec[1]} ${dep}")
      // 0x8A15002B: the package is already installed and winget has no upgrade.
      if (status!=0 && status!=-1978335189) ErrMorphoPMDep.throw()
    } else systemErrCheck("${spec[1]} ${dep}", ErrMorphoPMDep)
  }

  _unquote(s) { // Strip one matching pair of double quotes from an os-release value.
    if (s.count()>=2 && s[0]=="\"" && s[s.count()-1]=="\"") return s.substring(1, s.count()-1)
    return s
  }

  /** Distro ids from /etc/os-release, ID first and then ID_LIKE. */
  _linuxIds() {
    var ids = []
    try {
      var f = File("/etc/os-release", "r")
      for (l in f.lines()) {
        if (l.count()==0 || l[0]=="#") continue
        var parts = l.split("=")
        if (parts.count()<2) continue
        if (parts[0]!="ID" && parts[0]!="ID_LIKE") continue
        var val = self._unquote(parts[1])
        for (id in val.split(" ")) {
          if (id.count()>0) ids.append(id)
        }
      }
      f.close()
    } catch { "FlOpnFld": return ids }
    return ids
  }

  /** brew on macOS, winget on Windows, otherwise the Linux distro's package manager. */
  _detect() {
    if (System.platform()=="macos") return "brew"
    if (isWindows) return "winget"
    for (id in self._linuxIds()) {
      if (_pkgMgrNames.contains(id)) {
        var pm = _pkgMgrNames[id]
        if (pm=="apt" || pm=="pacman" || pm=="dnf") return pm
      }
    }
    return "apt"
  }
}

/** vcpkg discovery, installation, and the CMake arguments it requires. */
class VcpkgManager is ExternalPackageManager {
  init(name) {
    self.triplet = "x64-windows"
    self.root = self._find()
    if (!self.root) {
      ErrMorphoPMDep.throw("Package ${name} needs vcpkg to build on Windows. Install it from https://github.com/microsoft/vcpkg so that vcpkg.exe is on PATH or at C:\\vcpkg\\vcpkg.exe")
    }
  }

  install(dep) {
    print "Using vcpkg to install ${dep}"
    Error("VCPkgWaiting", "The first build of a native library can take several minutes.").warning()
    var exe = Folder.normalizePath("${self.root}/vcpkg.exe")
    systemErrCheck("\"${exe}\" install ${dep} --triplet ${self.triplet}", ErrMorphoPMDep)
  }

  cmakeOptions() {
    return [ "-DCMAKE_TOOLCHAIN_FILE=\"${_forward("${self.root}/scripts/buildsystems/vcpkg.cmake")}\"",
             "-DVCPKG_TARGET_TRIPLET=${self.triplet}",
             "-DVCPKG_MANIFEST_MODE=OFF" ]
  }

  // Directory containing vcpkg.exe
  _find() {
    var candidates = []
    var found = _firstLine(System.subprocess("where vcpkg 2>nul")["stdout"])
    if (found.count()>0) candidates.append(_parentDir(found))
    candidates.append("C:/vcpkg")
    candidates.append("${homeFolder}/vcpkg")

    var withPackages = nil
    var any = nil
    for (root in candidates) {
      var exe = Folder.normalizePath("${root}/vcpkg.exe")
      if (!File.isFile(exe)) continue
      if (!any) any = Folder.normalizePath(root)
      if (Folder.isFolder("${root}/installed")) withPackages = Folder.normalizePath(root)
    }
    if (withPackages) return withPackages
    return any
  }
}

