/** The config file is a .json dictionary holding configuration information for morphopm, including the versions of currently installed packages */
class MorphoConfig {
  init(file) {
    self.file = file 
    self.load() 
  }

  load() {
    try {
      var f = File(self.file, "r")
      var data = f.readall()
      f.close() 
      self.config = JSON.parse(data)
    } catch {
      "FlOpnFld" : 
      self.config = { }
      self.save() 
    }
    var label = nil
    if (self.config.contains("@packagemanager")) label = self.config["@packagemanager"]
    self.packagemanager = SystemPackageManager(label)
    if (label != self.packagemanager.name) {
      self.config["@packagemanager"] = self.packagemanager.name
      self.save()
    }
  }

  save() {
    var data = JSON.tostring(self.config)
    var f = File(self.file, "w")
    f.write(data)
    f.close() 
  }

  isInstalled(package) {
    return self.config.contains(package)
  }

  install(package, version) {
    self.config[package]=version
    self.save() 
  }

  uninstall(package) {
    if (self.isInstalled(package)) {
      self.config.remove(package)
      self.save() 
    }
  }

  /** Installed package names, leaving out configuration keys such as @packagemanager. */
  installedPackages() {
    var names = []
    for (key in self.config.keys()) {
      if (key.count()>0 && key[0]!="@") names.append(key)
    }
    return names
  } 

  index(package) { 
    if (self.isInstalled(package)) {
      return self.config[package]
    }  
    return nil 
  }

  _findDefinitions() {
    for (f in defnsFolderLocations) {
      var fnormal = Folder.normalizePath(f)
      if (Folder.isFolder(fnormal)) return fnormal
    }
    return nil 
  }

  packageDefns() {
    if (self.isInstalled("@packagedefns")) {
      var path = self.config["@packagedefns"]
      if (Folder.isFolder(path)) return path
    }
    var defns = self._findDefinitions()
    if (defns) return defns
    
    ErrMorphoPckgDefns.throw() 
  }

  setPackageDefns(path) {
    self.config["@packagedefns"] = path
    self.save() 
  }

  setPackageManager(name) {
    self.packagemanager = SystemPackageManager(name)
    self.config["@packagemanager"] = self.packagemanager.name
    self.save()
  }
}

/* -------------------
 * MorphoPackage 
 * ------------------- */

var _props = ("name", "version", "git", "url", "build", "dependencies", "requires", "morphomin", "morphomax")

class MorphoPackage {
  init(filename) {
    for (p in _props) self[p]=nil
    self.load(filename)
  }

  load(filename) {
    var f = File(filename, "r")
    var contents = f.readall()
    f.close() 

    var dict=JSON.parse(contents)
    if (isdictionary(dict)) {
      for (key in dict.keys()) {
        self[key] = dict[key]
      }
      self.defn = filename
    }
  }

  prnt() {
    System.prnt("${self.name} (${self.version})")
  }
}

/* ----------------------
 * MorphoPackageDatabase 
 * ---------------------- */

/** The package database is a folder containing .json files that define packages available for morphopm to install */
class MorphoPackageDatabase {
  init(folder) {
    self.folder = folder
    self.defns = self.load()
  }

  _hasJsonExt(file) {
    var el = _baseName(file).split(".")
    return el.count()>1 && el[-1]=="json"
  }

  load() {
    var defnlist=Folder.contents(self.folder)
    var defns = {} 

    for (def in defnlist) {
      if (!self._hasJsonExt(def)) continue
      var p = MorphoPackage(Folder.normalizePath("${self.folder}/${def}"))
      defns[p.name] = p
    }

    return defns
  }  

  contains(name) { // Check if we have a given package name
    return self.defns.contains(name)
  }  

  index(name) { // Retrieve the package definition from the package name
    return self.defns[name]
  }

  _status(config, key, version) {
    if (config) {
      if (config.isInstalled(key)) {
        if (config[key]==_devMarker) return devMark
        if (config[key]==version) return checkMark
        else return upArrow
      } 
    } 
    return "" 
  }

  list(config=nil) {
    var names = []
    for (key in self.defns.keys()) names.append(key)
    names.sort()

    var table = []
    for (key in names) {
      var current = self.defns[key].version
      table.append([key, "(${current})", self._status(config, key, current)])
    }

    displayTable(Array(table))
  }
}

/* -----------------------
 * MorphoPackageInstaller 
 * ----------------------- */

class MorphoPackageInstaller {
  init(package, env, packagemanager) {
    self.package = package
    self.env = env
    self.packagemanager = packagemanager
    self.vcpkg = nil
  }

  _unzip(src, dest, err) {
    var nsrc = Folder.normalizePath(src), ndest = Folder.normalizePath(dest)
    if (isWindows) systemErrCheck("tar -xf ${nsrc} -C ${ndest}", err)
    else systemErrCheck("unzip -o -q ${src} -d ${dest}", err)
  }

  _move(src, dest, err) {
    if (isWindows) {
      var nsrc = Folder.normalizePath(src)
      var ndest = Folder.normalizePath(dest)
      systemErrCheck("powershell -Command \"Move-Item -LiteralPath '${nsrc}' -Destination '${ndest}' -Force\"", err)
    } else systemErrCheck("mv -f ${src} ${dest}", err)
  }

  _removeFile(file) {
    if (isWindows) {
      system("del /f /q ${Folder.normalizePath(file)} >nul 2>&1")
    } else system("rm -f ${file}")
  }

  _removeFile(file, err) {
    if (isWindows) {
      systemErrCheck("del /f /q ${Folder.normalizePath(file)} >nul 2>&1", err)
    } else systemErrCheck("rm ${file}", err)
  }

  _removeFolder(folder) {
    if (isWindows) {
      system("rmdir /s /q ${Folder.normalizePath(folder)}")
    } else system("rm -rf ${folder}")
  }

  _removeFolder(folder, err) {
    if (isWindows) {
      systemErrCheck("rmdir /s /q ${Folder.normalizePath(folder)}", err)
    } else systemErrCheck("rm -rf ${folder}", err)
  }

  // Remove a failed install
  _cleanupFailedInstall(location) {
    print "Cleaning up failed install of ${self.package.name}"
    self.deactivate(location)
    var tmp = "${location}-tmp"
    if (Folder.isFolder(tmp)) self._removeFolder(tmp)
    self._removeFile("${location}.zip")
    if (Folder.isFolder(location)) self._removeFolder(location)
  }

  _recover(location, err) {
    self._cleanupFailedInstall(location)
    err.throw()
  }

  fetch(location) {
    print "Fetching package ${self.package.name}"
    systemErrCheck("curl -L ${self.package.url} -o ${location}.zip", ErrMorphoPMFtch)
  }

  // Top-level folder in the unpacked archive
  _findArchiveRoot(tmp) {
    var name = self.package.name
    var version = self.package.version
    var candidates = [ "morpho-${name}-main",
                       "morpho-${name}-${version}",
                       "morpho-${name}-v${version}" ]

    for (c in candidates) {
      if (Folder.isFolder("${tmp}/${c}")) return c
    }

    // Fallback: use the first subdirectory in the archive
    for (item in Folder.contents(tmp)) {
      if (Folder.isFolder("${tmp}/${item}")) return item
    }

    ErrMorphoPMUnzp.throw()
  }

  unzip(location) {
    var tmp = "${location}-tmp"
    print "Unzipping package ${self.package.name}"

    // Extract zip contents into a temporary folder
    if (Folder.isFolder(location)) self._removeFolder(location)
    if (Folder.isFolder(tmp)) self._removeFolder(tmp)
    try { Folder.create(tmp) } catch { "FldrCrtFld": ErrMorphoPckgFldr.throw() }

    self._unzip("${location}.zip", tmp, ErrMorphoPMUnzp)

    // Move the contents of the temporary folder into the proper place
    var subfldr = self._findArchiveRoot(tmp)
    self._move("${tmp}/${subfldr}", location, ErrMorphoPMUnzp)

    // Cleanup
    self._removeFile("${location}.zip", ErrMorphoPMRmZp)
    self._removeFolder(tmp, ErrMorphoPMRmZp)
  }

  // True when Visual Studio's clang-cl toolset is installed
  _hasClangCl() {
    var vswhere = "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
    if (!File.isFile(vswhere)) return false
    var result = System.subprocess("\"${vswhere}\" -latest -requires Microsoft.VisualStudio.Component.VC.Llvm.Clang -property installationPath")
    return _firstLine(result["stdout"]).count()>0
  }

  // Morpho install root
  _morphoPrefix() {
    var exe = _firstLine(System.subprocess("where morpho6")["stdout"])
    if (exe.count()==0) return nil
    return _parentDir(_parentDir(exe))
  }

  prereq() {
    var pm = self.packagemanager.name 

    if (self.package.dependencies &&
      self.package.dependencies.contains(pm)) {
    
      print "Obtaining dependencies for ${self.package.name}"  
      self.packagemanager.installAll(self.package.dependencies[pm])
    }

    if (isWindows && self.package.dependencies &&
        self.package.dependencies.contains("vcpkg")) {
      self.vcpkg = VcpkgManager(self.package.name)
      print "Obtaining vcpkg dependencies for ${self.package.name}"
      self.vcpkg.installAll(self.package.dependencies["vcpkg"])
    }
  }

  _cmake(location) {
    print "Building package ${self.package.name} with CMake"

    var bld = "${location}/build"
    var args = [ "cmake",
                 "-S", "\"${_forward(location)}\"",
                 "-B", "\"${_forward(bld)}\"",
                 "-DCMAKE_INSTALL_PREFIX=\"${_forward(location)}\"",
                 "-DCMAKE_BUILD_TYPE=Release" ]
    // clang-cl and the Morpho headers
    if (isWindows && isstring(self.package.build) && self.package.build=="cmake") {
      if (!self._hasClangCl()) {
        ErrMorphoPMCmk.throw("Building on Windows needs the Visual Studio C++ Clang tools (clang-cl). MSVC stops with error C2099 on Morpho class declarations. In the Visual Studio Installer, add 'C++ Clang Compiler for Windows', then try again.")
      }
      var prefix = self._morphoPrefix()
      if (!prefix || !File.isFile("${prefix}/include/morpho/morpho.h")) {
        ErrMorphoPMCmk.throw("Couldn't find the Morpho headers next to morpho6.exe")
      }
      args = args.join([ "-T", "ClangCL",
                         "-DCMAKE_PREFIX_PATH=\"${_forward(prefix)}\"" ])
    }
    if (self.vcpkg) args = args.join(self.vcpkg.cmakeOptions())

    systemErrCheck(String.join(args, " "), ErrMorphoPMCmk)
    systemErrCheck("cmake --build \"${_forward(bld)}\" --config Release --target install", ErrMorphoPMCmk)
  }

  // Build step for this platform
  _buildKind() {
    var build = self.package.build
    if (!build) return nil
    if (isstring(build)) return build
    if (isdictionary(build) && build.contains(System.platform())) return build[System.platform()]
    return nil
  }

  build(location) {
    if (self._buildKind()=="cmake") self._cmake(location)
  }

  activate(location) {
    print "Activating package ${self.package.name}"  
    self.env.activate(location)
  }

  deactivate(location) {
    print "Deactivating package ${self.package.name}"  
    self.env.deactivate(location)
  }

  _install(location, acquire) {
    var loc = Folder.normalizePath(location)
    try {
      self.prereq()
      apply(acquire, loc)
      self.build(loc)
      self.activate(loc)
    } catch {
      "ErrMorphoPMDep": self._recover(loc, ErrMorphoPMDep)
      "ErrMorphoPMFtch": self._recover(loc, ErrMorphoPMFtch)
      "ErrMorphoPMClone": self._recover(loc, ErrMorphoPMClone)
      "ErrMorphoPMPckgFldr": self._recover(loc, ErrMorphoPckgFldr)
      "ErrMorphoPMUnzp": self._recover(loc, ErrMorphoPMUnzp)
      "ErrMorphoPMRmZp": self._recover(loc, ErrMorphoPMRmZp)
      "ErrMorphoPMCmk": self._recover(loc, ErrMorphoPMCmk)
    }
  }

  install(location) {
    print "Installing package ${self.package.name}"
    self._install(location, fn (loc) {
      self.fetch(loc)
      self.unzip(loc)
    })
  }

  // Install from the package git repository
  devinstall(location) {
    print "Cloning package ${self.package.name}"
    self._install(location, fn (loc) {
      if (!self.package.git) ErrMorphoPMClone.throw()
      systemErrCheck("git clone \"${self.package.git}\" \"${loc}\"", ErrMorphoPMClone)
    })
  }

  uninstall(location) {
    var loc = Folder.normalizePath(location)
    self.deactivate(loc) 
    print "Uninstalling package ${self.package.name}"
    if (Folder.isFolder(loc)) {
      self._removeFolder(loc, ErrMorphoPMRmPckg)
    }
  }
}

/* ----------------------
 * MorphoPackageManager 
 * ---------------------- */

class MorphoPackageManager {
  init(config, env) {
    self.config = config 
    self.env = env 
    self.loadDatabase()
  }

  loadDatabase() {
    self.database = MorphoPackageDatabase(self.config.packageDefns())
  }

  help() {
    print "Morphopm is a simple package manager for morpho"
    print "Usage:"
    print "morphopm help                     - displays this help message" 
    print "morphopm install <packagename>    - installs a package"
    print "morphopm devinstall <packagename> - clones a package for development"
    print "morphopm list                     - lists available packages"
    print "morphopm open <packagename>       - opens the install folder of a package"
    print "morphopm path <packagename>       - prints the install path of a package"
    print "morphopm uninstall <packagename>  - uninstalls a package"
    print "morphopm upgrade <packagename>    - upgrades a package to the latest version"
    print "morphopm setdatabase <path>       - use a custom package definitions folder"
    print "morphopm setpackagemanager <name> - use apt, pacman, dnf, brew, or winget"
    print "morphopm version                  - displays version information"
  }

  _setDatabase(path) {
    path = _absPath(path)
    if (Folder.isFolder(path)) {
      self.config.setPackageDefns(path)
      self.loadDatabase()
      print "Package database set to ${path}"
    } else ErrMorphoPckgDefns.throw()
  }

  _setPackageManager(name) {
    self.config.setPackageManager(name)
    print "Package manager set to ${self.config.packagemanager.name}"
  }

  install(name) {
    self.loadDatabase()
    if (self.config[name]) {
      ErrMorphoPMAlrdy.warning("Package ${name} is already installed")
    } else if (self.database.contains(name)) {
      self._ensure(name, [], false)
    } else ErrMorphoPMUnrcgnzdPckg.throw() 
  }

  // Install a package and its requirements
  _ensure(name, stack, mustUpgrade) {
    if (stack.contains(name)) ErrMorphoPMReqCycle.throw("Package requirement cycle involving ${name}")

    var next = []
    for (item in stack) next.append(item)
    next.append(name)

    var pkg = self.database[name]
    if (!self._isDev(name)) self._checkMorphoVersion(pkg)
    self._satisfyRequires(pkg, next)

    if (!self.config.isInstalled(name)) {
      self._installBody(name)
    } else if (mustUpgrade && self._isDev(name)) {
      ErrMorphoPMDevUp.warning("Package ${name} is a dev install; cd to the package folder and run 'git pull' to update it.")
    } else if (mustUpgrade) {
      self._remove(name)
      self._installBody(name)
    }
  }

  _isDev(name) {
    return self.config.isInstalled(name) && self.config[name]==_devMarker
  }

  // Reject a package outside its Morpho version range
  _checkMorphoVersion(pkg) {
    if (!pkg.morphomin && !pkg.morphomax) return
    var current = currentMorphoVersion()
    if (pkg.morphomin && Version(pkg.morphomin).gt(current)) {
      ErrMorphoPMOutdtd.throw("Your copy of morpho (version ${current.toString()}) is too old for this package: version ${pkg.morphomin} is required")
    }
    if (pkg.morphomax && current.gt(Version(pkg.morphomax))) {
      ErrMorphoPMTooNew.throw("Your copy of morpho (version ${current.toString()}) is too new for this package: version ${pkg.morphomax} is the newest supported")
    }
  }

  _installBody(name) {
    var pkg = self.database[name]
    MorphoPackageInstaller(pkg, self.env, self.config.packagemanager).install(self._packageLocation(name))
    self.config.install(pkg.name, pkg.version)
  }

  _satisfyRequires(pkg, stack) {
    if (!pkg.requires) return

    for (dep in pkg.requires.keys()) {
      if (!self.database.contains(dep)) ErrMorphoPMUnrcgnzdPckg.throw("Package ${pkg.name} requires ${dep}")
      if (stack.contains(dep)) ErrMorphoPMReqCycle.throw("${pkg.name} requires ${dep}, which is already being installed")
      if (self._isDev(dep)) continue // A dev checkout is the programmer's responsibility

      var constraint = VersionConstraint(pkg.requires[dep])
      var published = Version(self.database[dep].version)
      if (!constraint.satisfied(published)) ErrMorphoPMReq.throw("Package ${pkg.name} requires ${dep} ${constraint.toString()}, but version ${published.toString()} is available")

      if (!self.config.isInstalled(dep)) { // If not installed, install it
        print "Installing ${dep}, required by ${pkg.name}"
        self._ensure(dep, stack, false)
      } else { // If installed, check if it satisfies the requirement
        var installed = Version(self.config[dep])
        if (!constraint.satisfied(installed)) {
          if (published.gt(installed)) { // If the published version is greater, upgrade it
            print "Upgrading ${dep} to version ${published.toString()}, required by ${pkg.name}"
            self._ensure(dep, stack, true)
          } else ErrMorphoPMReq.throw("Package ${pkg.name} requires ${dep} ${constraint.toString()}, but version ${installed.toString()} is installed") // If the installed version is greater, throw an error
        }
      }
    }
  }

  uninstall(name) {
    self.loadDatabase()
    if (!self.config[name]) ErrMorphoPMNotInst.throw("Package ${name} is not installed")
    var users = self._requiredBy(name)
    if (users.count()>0) {
      var listed = String.join(users, ", ")
      ErrMorphoPMInUse.throw("Package ${name} is required by ${listed}")
    }
    self._remove(name)
  }

  /** Installed packages whose requires field names this package. */
  _requiredBy(name) {
    var users = []
    for (pkg in self.config.installedPackages()) {
      if (pkg==name || !self.database.contains(pkg)) continue
      var req = self.database[pkg].requires
      if (req && req.contains(name)) users.append(pkg)
    }
    users.sort()
    return users
  }

  _remove(name) {
    if (self.database.contains(name)) {
      var pkg = self.database[name]
      MorphoPackageInstaller(pkg, self.env, self.config.packagemanager).uninstall(self._packageLocation(name))
      self.config.uninstall(pkg.name)
    } else ErrMorphoPMUnrcgnzdPckg.throw()
  }

  _packageLocation(name) {
    return Folder.normalizePath("${packageFolder}/morpho-${name}")
  }

  _requireInstalled(name) {
    if (!self.config[name]) ErrMorphoPMNotInst.throw("Package ${name} is not installed")
    return self._packageLocation(name)
  }

  _openFolder(location) {
    if (System.platform()=="macos") {
      systemErrCheck("open ${location}", ErrMorphoPMOpen)
    } else if (isWindows) {
      systemErrCheck("powershell -Command \"Invoke-Item -LiteralPath '${Folder.normalizePath(location)}'\"", ErrMorphoPMOpen)
    } else {
      systemErrCheck("xdg-open ${location}", ErrMorphoPMOpen)
    }
  }

  path(name) {
    print self._requireInstalled(name)
  }

  open(name) {
    self._openFolder(self._requireInstalled(name))
  }

  devinstall(name) {
    self.loadDatabase()
    if (self.config[name]) {
      ErrMorphoPMAlrdy.warning("Package ${name} is already installed")
    } else if (self.database.contains(name)) {
      var loc = self._packageLocation(name)
      if (Folder.isFolder(loc)) ErrMorphoPMDev.throw("Package folder ${loc} already exists. Uninstall it before a dev install")
      var stack = [ name ]
      self._satisfyRequires(self.database[name], stack)
      var pkg = self.database[name]
      MorphoPackageInstaller(pkg, self.env, self.config.packagemanager).devinstall(loc)
      self.config.install(pkg.name, _devMarker)
    } else ErrMorphoPMUnrcgnzdPckg.throw()
  }

  upgrade(name) { 
    self.loadDatabase()
    if (!self.database.contains(name)) ErrMorphoPMUnrcgnzdPckg.throw() 

    if (self._isDev(name)) {
      ErrMorphoPMDevUp.warning("Package ${name} is a dev install; cd to the package folder and run 'git pull' to update it.")
    } else if (self.config[name]) {
      var vInstalled = Version(self.config[name])
      var vLatest = Version(self.database[name].version)

      if (vLatest.gt(vInstalled)) {
        print "Upgrading package ${name} to version ${vLatest.toString()}."
        self._ensure(name, [], true)
      } else print "Package ${name} is already up-to-date."
    } else ErrMorphoPMNotInst.throw("Package ${name} is not installed")
  }

  _multi(func, args) {
    var n = args.count()
    if (n<2) ErrMorphoPMMssngPckg.throw()
    for (arg in args[1...n]) func(arg)
  }

  main(args) { // Parses commands
    if (args.count()>0) {
      if (args[0]=="help") {
        self.help()
      } else if (args[0]=="install") {
        self._multi(self.install, args) 
      } else if (args[0]=="devinstall") {
        self._multi(self.devinstall, args) 
      } else if (args[0]=="uninstall") {
        self._multi(self.uninstall, args) 
      } else if (args[0]=="upgrade") {
        self._multi(self.upgrade, args) 
      } else if (args[0]=="list") {
        self.loadDatabase()
        print "morphopm available packages: (${checkMark}=installed; ${upArrow}=upgrade available; ${devMark}=dev install)"
        self.database.list(config=self.config) 
      } else if (args[0]=="path") {
        self._multi(self.path, args)
      } else if (args[0]=="open") {
        self._multi(self.open, args)
      } else if (args[0]=="version") {
        print _version
      } else if (args[0]=="setdatabase") {
        self._multi(self._setDatabase, args)
      } else if (args[0]=="setpackagemanager") {
        self._multi(self._setPackageManager, args)
      } else {
        ErrMorphoPMUnrcgnzd.warning()
        self.help() 
      }
    } else self.help() 
  }
}

